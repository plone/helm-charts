{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values of the plone chart",
  "description": "See docs/reference/values.md. The postgresql and varnish sections also take the values of the cnpg cluster and varnish-cache charts.",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "profiles": {
          "type": "string"
        },
        "defaultLanguage": {
          "type": "string"
        },
        "admin": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "relstorage",
            "zeo"
          ]
        },
        "relstorage": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": [
                "integer",
                "string"
              ]
            },
            "secret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "keys": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "user": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "sslmode": {
              "type": "string",
              "enum": [
                "",
                "disable",
                "allow",
                "prefer",
                "require",
                "verify-ca",
                "verify-full"
              ]
            },
            "keepHistory": {
              "type": "boolean"
            },
            "blobCacheSize": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "zeo": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "clientCacheSize": {
              "type": "string"
            },
            "server": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "pullPolicy": {
                      "type": "string",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "persistence": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "accessMode": {
                      "type": "string"
                    },
                    "size": {
                      "type": "string"
                    },
                    "storageClass": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "env": {
                  "type": "array"
                },
                "resources": {
                  "type": "object"
                },
                "podAnnotations": {
                  "type": "object"
                },
                "podSecurityContext": {
                  "type": "object"
                },
                "securityContext": {
                  "type": "object"
                },
                "nodeSelector": {
                  "type": "object"
                },
                "tolerations": {
                  "type": "array"
                },
                "affinity": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "days": {
          "type": "integer"
        },
        "backoffLimit": {
          "type": "integer"
        },
        "activeDeadlineSeconds": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "env": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicas": {
          "type": "integer"
        },
        "updateStrategy": {
          "type": "object"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        "zodbCacheSize": {
          "type": "integer"
        },
        "env": {
          "type": "array"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicas": {
          "type": "integer"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        "env": {
          "type": "array"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "varnish": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "vcl": {
          "type": "string"
        }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "gateway",
            "ingress-nginx",
            "none"
          ]
        },
        "hostname": {
          "type": "string"
        },
        "https": {
          "type": "boolean"
        },
        "port": {
          "type": [
            "integer",
            "string"
          ]
        },
        "gateway": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            },
            "parentRefs": {
              "type": "array"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "ingressNginx": {
          "type": "object",
          "properties": {
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "tls": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
